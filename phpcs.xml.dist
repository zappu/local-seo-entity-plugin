<?xml version="1.0"?>
<ruleset name="local-seo-entity-plugin">
	<description>Code-Standard: WordPress Coding Standards mit PSR-4-Dateinamen.</description>

	<file>.</file>
	<exclude-pattern>/vendor/*</exclude-pattern>
	<exclude-pattern>/build/*</exclude-pattern>
	<exclude-pattern>/node_modules/*</exclude-pattern>

	<arg name="extensions" value="php"/>
	<arg name="cache" value=".phpcs-cache"/>
	<arg name="parallel" value="8"/>
	<arg value="sp"/>

	<config name="minimum_wp_version" value="6.4"/>
	<config name="testVersion" value="8.1-"/>

	<rule ref="WordPress-Extra">
		<!-- Klassen folgen PSR-4 (Dateiname = Klassenname), nicht class-*.php. -->
		<exclude name="WordPress.Files.FileName"/>
	</rule>

	<rule ref="WordPress-Docs"/>

	<!-- Tests: Methodennamen erklären sich selbst, keine Doc-Kommentare je Testmethode. -->
	<rule ref="Squiz.Commenting.FunctionComment.Missing">
		<exclude-pattern>/tests/*</exclude-pattern>
	</rule>
	<rule ref="Squiz.Commenting.FunctionComment.MissingParamTag">
		<exclude-pattern>/tests/*</exclude-pattern>
	</rule>
	<rule ref="Generic.Commenting.DocComment.MissingShort">
		<exclude-pattern>/tests/*</exclude-pattern>
	</rule>
	<rule ref="WordPress.PHP.DevelopmentFunctions">
		<exclude-pattern>/tests/*</exclude-pattern>
	</rule>

	<rule ref="PHPCompatibilityWP"/>

	<!-- Fehlalarm: $this in Methoden von PHP-8.1-Enums. -->
	<rule ref="PHPCompatibility.Variables.ForbiddenThisUseContexts.OutsideObjectContext">
		<exclude-pattern>/src/Workflow/*Status.php</exclude-pattern>
	</rule>

	<!-- WP-CLI gibt die Signatur ($args, $assoc_args) vor, auch wenn ein Befehl sie nicht braucht. -->
	<rule ref="Generic.CodeAnalysis.UnusedFunctionParameter">
		<exclude-pattern>/src/Cli/*</exclude-pattern>
	</rule>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="local-seo-entity-plugin"/>
			</property>
		</properties>
	</rule>

	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="lsec"/>
				<element value="Lsec"/>
			</property>
		</properties>
	</rule>
</ruleset>
